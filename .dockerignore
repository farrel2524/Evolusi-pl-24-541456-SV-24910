# ---------------------------------------------------------------
# Required exclusions
# ---------------------------------------------------------------
# NOTE: "**/" matches at any depth. A bare "node_modules" would only
# match the top level and miss frontend/node_modules.
**/node_modules
**/vendor
**/.git
.env
.env.*

# ---------------------------------------------------------------
# Why vendor is excluded: dependencies are installed INSIDE the image
# by `composer install`, so a host copy (possibly Windows/other PHP
# version) must never overwrite it.
# Why .env is excluded: secrets must not be baked into image layers.
# APP_KEY etc. are supplied at runtime (docker run -e ...).
# ---------------------------------------------------------------

# Separate Vue app (has its own CI workflow, not served by this image)
frontend

# Laravel runtime artefacts - recreated inside the container.
# bootstrap/cache/*.php can hold stale package/config manifests from the
# host (wrong paths, dev-only providers) and would break the container.
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
public/hot
public/storage
**/*.sqlite
**/*.log

# VCS / CI / editor / OS noise
.github
.gitattributes
.gitignore
.idea
.vscode
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo

# Docker files and docs are not needed at runtime
Dockerfile
.dockerignore
docker-compose*.yml
*.md
*.zip
